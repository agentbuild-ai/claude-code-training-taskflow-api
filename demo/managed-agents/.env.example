# Anthropic API key for an org with Managed Agents beta access.
# The SDK sends `anthropic-beta: managed-agents-2026-04-01` automatically —
# your org just needs the beta enabled.
ANTHROPIC_API_KEY=

# Printed by `npm run setup` (setup.ts). Run it once, then paste both here.
AGENT_ID=
ENVIRONMENT_ID=

# GitHub Personal Access Token, fine-grained, scoped to ONLY this one repo
# (agentbuild-ai/claude-code-training-taskflow-api).
# Required permission: Contents -> Read and write
# (write is required because the final outcome pushes the agent's branch).
GITHUB_TOKEN=

# Branch the session's repo mount is checked out from. Must already exist
# on the remote — push your local changes before running the demo.
BASE_BRANCH=completed_tasks
